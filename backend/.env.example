# Copy to .env (in this directory) and edit. It is gitignored and is read both
# by Compose interpolation and by the API container (env_file).
#
# compose.dev.yaml keeps a fresh clone working with dev issuer/JWKS and the
# database password "twt-dev". compose.prod.yaml requires POSTGRES_PASSWORD,
# OAUTH_ISSUER_URL, OAUTH_AUDIENCE, OAUTH_JWKS_URL and TWT_DOMAIN and refuses
# to start without them. Do not use the dev defaults for a real deployment.

# --- Postgres / compose ---
# Keep the password URL-safe (letters, digits, -._~): it is embedded in
# DATABASE_URL. Existing volumes keep the password they were initialised with.
# POSTGRES_PASSWORD=change-me

# --- Public origin / CORS / CSP ---
# The compose proxy is same-origin, so CORS is not needed. Set PUBLIC_URL (or
# CORS_ALLOWED_ORIGINS) only when the web frontend has its own origin.
# PUBLIC_URL=https://twt.example.com
# CORS_ALLOWED_ORIGINS=https://twt.example.com
# Extra connect-src origins for a cross-origin API/IdP; 'self' is implicit.
# TWT_CSP_CONNECT_SRC=https://idp.example.com

# --- TLS edge (compose.prod.yaml) ---
# Bare domain; Caddy obtains the certificate. Leave unset when an external
# TLS terminator fronts 127.0.0.1:8080.
# TWT_DOMAIN=twt.example.com

# --- OAuth / OIDC ---
# The backend proxies discovery and token grants, so the browser does not need
# IdP CORS. Register the web page URL as a redirect URI on the client.
# OAUTH_ISSUER_URL=https://idp.example.com/
# OAUTH_AUDIENCE=twt-api
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_SCOPES=openid,profile,offline_access
# OAUTH_JWKS_URL=https://idp.example.com/jwks

# Optional change-log retention window.
# RETENTION_DAYS=180

# Dev-only static JWKS: compose mounts ./dev and sets OAUTH_JWKS_FILE and
# I_ACCEPT_DEV_JWKS itself. OAUTH_JWKS_URL above wins over that file.
# OAUTH_JWKS_FILE=/app/jwks/jwks.json
