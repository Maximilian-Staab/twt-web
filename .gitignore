# build outputs
/backend/target/
**/target/

# rust
**/*.rs.bk

# local config
local.properties

# IDE
.idea/
*.iml
.DS_Store

# devenv artifacts
.devenv/
/wordlists

# backend deployment env (contains IdP client ids)
backend/.env

# backend dev JWT keypair — per-developer, generated by
# backend/dev/gen-dev-keys.sh; never commit keys or sample tokens.
backend/dev/*
!backend/dev/gen-dev-keys.sh

# python bytecode
__pycache__/
*.pyc
